<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/pause_menu_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clickable="true"
    android:focusable="true"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:baselineAligned="false">

        <!-- Left Column: Saved States (70%) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.7"
            android:background="#111111"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Saved States"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginBottom="16dp"/>

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <LinearLayout
                    android:id="@+id/states_list_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <!-- Dynamic states go here -->
                </LinearLayout>
            </ScrollView>

            <TextView
                android:id="@+id/tv_no_states"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="No saved states"
                android:textColor="#888888"
                android:gravity="center"
                android:layout_marginTop="32dp"
                android:visibility="gone"/>
        </LinearLayout>

        <!-- Right Column: Controls (30%) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.3"
            android:background="#222222"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:text="PAUSED"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold"
                android:layout_marginBottom="16dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Volume"
                android:textColor="#BBBBBB"
                android:textSize="12sp" />

            <SeekBar
                android:id="@+id/volume_seekbar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:max="100"
                android:progress="100" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="16dp" />

            <Button
                android:id="@+id/btn_resume"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:backgroundTint="#444444"
                android:text="Resume"
                android:textSize="12sp"
                android:textColor="#FFFFFF"
                android:padding="0dp"/>

            <Button
                android:id="@+id/btn_save_state"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="8dp"
                android:backgroundTint="#445544"
                android:text="Save State"
                android:textSize="12sp"
                android:textColor="#FFFFFF"
                android:padding="0dp"/>

            <Button
                android:id="@+id/btn_reload"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="8dp"
                android:backgroundTint="#444444"
                android:text="Reload ROM"
                android:textSize="12sp"
                android:textColor="#FFFFFF"
                android:padding="0dp"/>

            <Button
                android:id="@+id/btn_settings"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="8dp"
                android:backgroundTint="#444444"
                android:text="Settings"
                android:textSize="12sp"
                android:textColor="#FFFFFF"
                android:padding="0dp"/>

            <Button
                android:id="@+id/btn_snapshot"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="8dp"
                android:backgroundTint="#444444"
                android:text="Set as Thumb"
                android:textSize="12sp"
                android:textColor="#FFFFFF"
                android:padding="0dp"/>

        </LinearLayout>
    </LinearLayout>
</FrameLayout>