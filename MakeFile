CC = cc
CORE_FILES = $(wildcard src/core/*.c src/core/mappers/*.c)
SDL_DIR = deps/SDL
SDL_TTF_DIR = deps/SDL_ttf
CFLAGS = -march=native -funroll-loops -ffast-math
SDL_INCLUDES = -I$(SDL_DIR)/include -I$(SDL_TTF_DIR)/include

SDL3_LIB = build/sdl3/libSDL3.a
SDL3_TTF_LIB = build/sdl3_ttf/libSDL3_ttf.a
SDL_SYSLIBS = -lsetupapi -lwinmm -lgdi32 -limm32 -lole32 -loleaut32 -lversion -lcfgmgr32 -lhid -luuid -lrpcrt4


ANDROID_SDK ?= $(USERPROFILE)\AppData\Local\Android\Sdk
ANDROID_NDK_VERSION ?= 27.1.12297006
ANDROID_NDK ?= $(ANDROID_SDK)\ndk\$(ANDROID_NDK_VERSION)
ANDROID_TOOLCHAIN = $(ANDROID_NDK)\toolchains\llvm\prebuilt\windows-x86_64\bin
ANDROID_CC = $(ANDROID_TOOLCHAIN)\aarch64-linux-android26-clang
ANDROID_SO_OUT = mobile\NesEm\modules\nes-core\android\src\main\jniLibs\arm64-v8a\libnescore.so

sdl3-clean:
	-del /q $(SDL3_LIB) 2>nul
	-del /q $(SDL3_TTF_LIB) 2>nul

sdl3:
	cmake -S $(SDL_DIR) -B build/sdl3 -G "MinGW Makefiles" -DCMAKE_BUILD_TYPE=Release -DBUILD_SHARED_LIBS=OFF -DSDL_EXAMPLES=OFF
	cmake --build build/sdl3

sdl3-ttf:
	cmake -S $(SDL_TTF_DIR) -B build/sdl3_ttf -G "MinGW Makefiles" -DCMAKE_BUILD_TYPE=Release -DBUILD_SHARED_LIBS=OFF -DSDL3_DIR=$(CURDIR)/build/sdl3 -DSDLTTF_VENDORED=ON -DSDLTTF_SAMPLES=OFF -DSDLTTF_INSTALL=OFF
	cmake --build build/sdl3_ttf

core-windows:
	$(CC) -shared -Ofast -flto -funroll-loops -ffast-math -Wattributes -march=native -DNES_CORE_SILENT $(CORE_FILES) -o build/windows/core.dll

windows: sdl3 sdl3-ttf core-windows
	$(CC) src/main.cpp \
	    src/dev/dev.cpp src/dev/game_window.cpp src/dev/debug_window.cpp src/dev/nametable_viewer.cpp src/dev/pattern_table.cpp \
	    deps/imgui/imgui.cpp deps/imgui/imgui_draw.cpp deps/imgui/imgui_widgets.cpp deps/imgui/imgui_tables.cpp \
	    deps/imgui/backends/imgui_impl_sdl3.cpp deps/imgui/backends/imgui_impl_sdlrenderer3.cpp \
	    -O3 -flto -funroll-loops -ffast-math -march=native -fomit-frame-pointer \
	    $(CFLAGS) $(SDL_INCLUDES) -I deps/imgui -I deps/imgui/backends -I src/dev \
	    build/windows/core.dll $(SDL3_LIB) $(SDL3_TTF_LIB) $(SDL_SYSLIBS) -lstdc++ -s \
	    -o build/windows/main.exe

manual-windows: sdl3 sdl3-ttf core-windows
	$(CC) src/main_manual.cpp \
	    src/dev/dev.cpp src/dev/game_window.cpp src/dev/debug_window.cpp src/dev/nametable_viewer.cpp src/dev/pattern_table.cpp \
	    deps/imgui/imgui.cpp deps/imgui/imgui_draw.cpp deps/imgui/imgui_widgets.cpp deps/imgui/imgui_tables.cpp \
	    deps/imgui/backends/imgui_impl_sdl3.cpp deps/imgui/backends/imgui_impl_sdlrenderer3.cpp \
	    -O3 -flto -funroll-loops -ffast-math -march=native -fomit-frame-pointer \
	    $(CFLAGS) $(SDL_INCLUDES) -I deps/imgui -I deps/imgui/backends -I src/dev \
	    build/windows/core.dll $(SDL3_LIB) $(SDL3_TTF_LIB) $(SDL_SYSLIBS) -lstdc++ -s \
	    -o build/windows/main_manual.exe

core-wasm:
	emcc $(CORE_FILES) -O3 -DNES_CORE_SILENT -DPLATFORM_WEB \
	-o web/output.js \
	-Wl,--export=boot_cpu \
	-Wl,--export=tick_cpu \
	-Wl,--export=shutdown_cpu \
	-Wl,--export=load_cartridge_and_connect_to_bus \
	-Wl,--export=boot_nes_audio \
	-Wl,--export=update_apu \
	-Wl,--export=apu_mix_samples \
	-Wl,--export=connect_controller_to_console \
	-Wl,--export=boot_ppu \
	-Wl,--export=request_frame \
	-Wl,--export=kill_ppu \
	-Wl,--export=nes_dealloc \
	-Wl,--export=nes_alloc \
	-s EXPORTED_RUNTIME_METHODS="['HEAPU8', 'HEAPU16', 'HEAPU32', 'HEAPF32']" \
	-s MODULARIZE=1 \
	-s FORCE_FILESYSTEM=1 \
	-s EXPORT_NAME="initialiseNES" \
	-s ASYNCIFY=1

core-android-so: $(ANDROID_SO_OUT)

$(ANDROID_SO_OUT): mobile/NesEm/modules/nes-core/android/jni/nes-bridge.c mobile/NesEm/modules/nes-core/android/jni/audio_android.c
	@if not exist "$(ANDROID_CC).cmd" (echo NDK clang not found: $(ANDROID_CC).cmd & exit /b 1)
	-mkdir mobile\NesEm\modules\nes-core\android\src\main\jniLibs\arm64-v8a 2>nul
	$(ANDROID_CC) -shared -fPIC -O3 \
		-std=c11 \
		-Isrc \
		-include stdio.h -include src/core/debug_log.h \
		-DANDROID_DEBUG_LOG \
		-DPLATFORM_ANDROID \
		$(CORE_FILES) mobile/NesEm/modules/nes-core/android/jni/nes-bridge.c mobile/NesEm/modules/nes-core/android/jni/audio_android.c \
		-lm -llog -landroid -laaudio -ljnigraphics \
		-o $@
